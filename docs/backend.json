
{
  "entities": {
    "Device": {
      "title": "Network Device",
      "description": "A representation of a network hardware node (Router, GPON, etc.)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ipAddress": { "type": "string" },
        "status": { "type": "string", "enum": ["ONLINE", "OFFLINE"] },
        "manufacturer": { "type": "string" },
        "firmware": { "type": "string" },
        "mac": { "type": "string" },
        "ssid": { "type": "string" },
        "type": { "type": "string", "enum": ["router", "extender", "gpon"] }
      },
      "required": ["name", "ipAddress", "status", "type"]
    },
    "DiagnosisLog": {
      "title": "AI Diagnosis Log",
      "description": "History of network troubleshooting results generated by Genkit.",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "summary": { "type": "string" },
        "rootCause": { "type": "string" },
        "confidenceScore": { "type": "number" },
        "problemDescription": { "type": "string" }
      },
      "required": ["timestamp", "summary", "rootCause"]
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/users/{userId}/devices/{deviceId}": {
      "schema": "Device",
      "description": "User's managed network devices."
    },
    "/users/{userId}/diagnoses/{diagnosisId}": {
      "schema": "DiagnosisLog",
      "description": "Historical diagnosis reports for the user."
    }
  }
}
